#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

"$repo_root/scripts/infisical-server" sm secrets export \
  --projectId 1239898e-9537-423b-a106-50ddca4bb1a1 \
  --env prod \
  --template "$repo_root/apps/casita/postgres-secret.yaml.tpl" \
  --silent |
kubectl apply --server-side --field-manager=infisical-bootstrap -f -
